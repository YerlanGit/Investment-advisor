# Приложение: claw-code-parity-main
# Переименуйте этот файл в .env и поместите сюда свои секреты

# ПРЕДУПРЕЖДЕНИЕ: НИКОГДА НЕ ПУШЬТЕ ФАЙЛ .env В КОДОВУЮ БАЗУ (GIT).

# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. ОБЯЗАТЕЛЕН: без него импорт `tg_bot` падает —
# бот без токена не «работает частично», он не работает.
# Прежнее имя RAMP_BOT_TOKEN пока тоже принимается, но с предупреждением.
OMBRI_BOT_TOKEN=
# Хэндл бота БЕЗ «@» — едет в отчёт и превращается в deep-link
# «Применить идею» (t.me/<хэндл>?start=scn_<n>). Дефолт — `branding.py`.
# BOT_USERNAME=Ombri_bot
# Белый список Telegram-id через запятую. НЕ ЗАДАНО → бот открыт всем;
# задано → отвечает только перечисленным (одна вежливая фраза остальным).
# TG_ALLOWED_USERS=

FINTECH_MASTER_KEY=your_generated_fernet_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Freedom Broker (Tradernet) — read-only API credentials.
# See config/.env.example for full documentation.
TRADERNET_PUBLIC_KEY=
TRADERNET_SECRET_KEY=
FREEDOM_API_KEY=
FREEDOM_API_SECRET=

# Base currency + risk-free rate for Sharpe / Sortino (Base Currency Approach).
# 🔴 Prod pins REPORTING_CURRENCY=USD (cloudbuild.yaml).  The price matrix and
# the RFR must be in ONE currency, and `ReportingCurrency.from_env` has a legacy
# branch: when ONLY KZ_RFR_ANNUAL is set it silently switches the whole report
# to KZT at 14% — a local run then disagrees with prod (`§−121`).  Keep the
# explicit USD pin; set KZ_RFR_ANNUAL only together with REPORTING_CURRENCY=KZT.
REPORTING_CURRENCY=USD
# USD RFR (3-mo T-bill / SOFR).  Unset → code default 0.045 (a STATIC estimate —
# review it when the Fed moves; the QC panel prints which one was used).
# US_RFR_ANNUAL=0.045
# KZ_RFR_ANNUAL=0.14

# ── Конкурентность отчётов (§−122) ───────────────────────────────────────────
# Сколько отчётов считается ОДНОВРЕМЕННО; остальные ждут в очереди и видят своё
# место. На 1 vCPU третий параллельный расчёт только растягивает всех.
MAX_CONCURRENT_REPORTS=2
# Потолок ожидания ответа Anthropic, с. По истечении — детерминированный фолбэк.
ANTHROPIC_TIMEOUT_S=300
# TTL аренды слота пользователя, с (страховка от краха; при graceful shutdown
# инстанс снимает свои аренды сам).
REPORT_LOCK_TTL_SEC=1800

# ── FRED (St. Louis Fed macro data) ──────────────────────────────────────────
# Free API key — register at https://fred.stlouisfed.org/docs/api/api_key.html
# Used by src/services/macro_data.py to pull yield curve, HY spread, PMI,
# VIX and breakeven-inflation for the DEEP regime page.  When this is
# empty, the macro_drivers block in the report is rendered with
# status="missing" placeholders — the rest of the pipeline still works.
FRED_API_KEY=

# ── HTML Report Delivery (GCS-backed signed URLs) ────────────────────────────
# Bucket where rendered HTML reports are uploaded.  When empty (e.g. local
# dev without GCP creds) the bot falls back to file:// links and logs a
# warning per call.  Create the bucket once, grant the bot's service
# account roles/storage.objectAdmin.
REPORT_BUCKET_NAME=
# Signed-URL lifetime in hours; default 168 (= 7 days).
REPORT_URL_TTL_HOURS=168

# ── Template version override (rollback knob) ───────────────────────────────
# v3 is the new prototype-grade banker design (default).  Set to v2 to
# roll back to the legacy hybrid (snapshot-bar + q-blocks) layout
# without redeploying code.
# REPORT_DEEP_VERSION=v3
# REPORT_BASIC_VERSION=v3

# Premium V2 report design (React/Tailwind). OFF → classic v3 Jinja templates.
PREMIUM_REPORT_ENABLED=false
