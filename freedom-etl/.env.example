# freedom-etl — шаблон окружения. Скопируйте в `.env` и заполните.
#
# 🔴 НИКОГДА не коммитьте заполненный `.env`. Ключи Tradernet дают доступ к
# брокерскому счёту; корневой `.gitignore` уже исключает `.env`, но проверьте
# `git status` перед первым коммитом.

# ── Tradernet / Freedom Broker ───────────────────────────────────────────────
# Одна учётная запись на весь сервис (ограничение архитектуры).
# Пара «публичный + секретный» выпускается в личном кабинете Tradernet.
TRADERNET_PUBLIC_KEY=
TRADERNET_SECRET_KEY=

# Базовый URL API. Для счетов, зарегистрированных в РК, рабочим может
# оказаться https://tradernet.kz или https://freedombroker.kz — ключ
# аутентифицируется не на всех доменах сразу.
TRADERNET_API_URL=https://tradernet.com

# ── PostgreSQL / TimescaleDB ─────────────────────────────────────────────────
# При запуске через docker-compose это значение перебивается адресом
# внутренней сети (см. docker-compose.yml).
DB_URL=postgresql://postgres:postgres@localhost:5432/quotes
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_COMMAND_TIMEOUT=60

# Учётные данные контейнера БД (читаются docker-compose).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quotes
POSTGRES_PORT=5432

# ── Универсум ────────────────────────────────────────────────────────────────
# Первичное наполнение таблицы tracked_tickers. Идемпотентно: повторный старт
# не дублирует и не воскрешает вручную отключённые бумаги.
SEED_TICKERS=AAPL.US,MSFT.US,NVDA.US,SPY.US,KEGC.KZ,HSBK.KZ

# ── Батчинг и лимиты ─────────────────────────────────────────────────────────
# BATCH_SIZE зажат сверху значением 50 (потолок API), BATCH_DELAY_SECONDS —
# снизу значением 2.0. Уменьшить паузу через env невозможно: «ускорить
# выгрузку» — самый вероятный способ получить бан на ключ.
BATCH_SIZE=50
BATCH_DELAY_SECONDS=2.0
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=2.0
BACKOFF_MAX_SECONDS=120
REQUEST_TIMEOUT_SECONDS=60

# ── Горизонт загрузки ────────────────────────────────────────────────────────
# Первичная загрузка нового тикера, календарных дней (1825 ≈ 5 лет — то же
# окно, что у риск-движка RAMP).
INITIAL_LOOKBACK_DAYS=1825
# Перекрытие при догрузке: брокер уточняет свечу после клиринга, UPSERT
# делает перезапрос безопасным.
RESYNC_OVERLAP_DAYS=3
# Незакрытый текущий день в базу не пишется. true — только для отладки:
# внутри сессии `close` это последняя сделка, а не цена закрытия.
INCLUDE_CURRENT_DAY=false

# ── Планировщик ──────────────────────────────────────────────────────────────
# 03:00 America/New_York = пост-маркет США закрыт + клиринг брокера
# (≈12:00 по Астане). Имя зоны, а не UTC-час: США переходят на летнее время.
SCHEDULE_HOUR=3
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=America/New_York
# Прогнать синхронизацию сразу при старте контейнера, не дожидаясь крона.
RUN_ON_START=false

LOG_LEVEL=INFO
